---
import { getCollection, getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import JoinForm from '../components/JoinForm.astro';
import Icon from '../components/Icon.astro';
import { site } from '../config/site';

const page = await getEntry('pages', 'home');
if (!page) throw new Error('Missing content: src/content/pages/home.md');
const { data } = page;
const s = data.sections ?? {};
const { Content: AboutText } = await render(page);
const { meeting, features } = site;

const byOrder = <T extends { data: { order: number } }>(a: T, b: T) => a.data.order - b.data.order;
const projects = features.work ? (await getCollection('projects')).sort(byOrder) : [];
const featured = projects.find((p) => p.data.featured);
const projectCards = projects.filter((p) => p !== featured);
const projectMeta = (p: (typeof projects)[number]) => [p.data.type, p.data.year, p.data.role].filter(Boolean).join(' · ');
const ads = features.ads ? (await getCollection('ads')).sort(byOrder) : [];
---

<BaseLayout title={data.title} description={data.description} isHome>
  <!-- Hero -->
  <section class="hero theme-cream" class:list={{ 'hero--image': data.heroImage }} style={data.heroImage ? `--hero-wash:${data.heroOverlay}` : undefined}>
    {
      data.heroImage && (
        <Image
          src={data.heroImage}
          alt={data.heroImageAlt}
          widths={[640, 1024, 1600, 2000]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          class="hero__bg"
        />
      )
    }
    <div class="container hero__inner">
      <div class="hero__text">
      <p class="eyebrow">{site.name}</p>
      <h1>{data.heading}</h1>
      {data.intro && <p class="lead hero__sub">{data.intro}</p>}
      <div class="btn-row">
        <a class="btn btn--primary" href="#join">{s.heroPrimary ?? 'Start a conversation'}</a>
        <a class="btn btn--secondary" href="#work">{s.heroSecondary ?? 'See my work'}</a>
      </div>
      <p class="hero__area">
        <Icon name="pin" size={18} />
        <span>{s.heroLocation ?? `${meeting.name}, ${meeting.city}`}</span>
      </p>
      </div>
      <!-- Green frame: shows heroPhoto from home.md, or stays empty until one is added -->
      <div class="hero__frame">
        {data.heroPhoto ? (
          <Image src={data.heroPhoto} alt={data.heroPhotoAlt} widths={[360, 540, 720, 1080]} sizes="(min-width: 56rem) 30vw, 90vw" loading="eager" class="hero__photo" />
        ) : (
          <div class="hero__photo hero__photo--empty" aria-hidden="true" />
        )}
      </div>
    </div>
  </section>

  <!-- Selected work -->
  {
    features.work && projects.length > 0 && (
      <section class="section theme-maroon" id="work" aria-labelledby="work-heading">
        <div class="container">
          <div class="section__head">
            <h2 id="work-heading">{s.workHeading ?? 'Websites'}</h2>
            {s.workIntro && <p class="lead">{s.workIntro}</p>}
          </div>

          {featured && (
            <article class="card project-featured">
              <Image src={featured.data.image} alt={featured.data.imageAlt} widths={[600, 900, 1200]} sizes="(min-width: 56rem) 55vw, 100vw" class="project__img" />
              <div class="project-featured__body">
                <p class="badge">{s.workFeatured ?? 'Featured'}</p>
                <h3>{featured.data.title}</h3>
                {featured.data.result && <p class="project-featured__result">{featured.data.result}</p>}
                {featured.data.stack.length > 0 && <p class="project__meta">{featured.data.stack.join(' · ')}</p>}
                <div class="project-featured__actions">
                  <a class="btn btn--primary" href={`/case-studies/${featured.id}/`}>
                    {s.workCaseStudy ?? 'Case study'}<span class="visually-hidden">: {featured.data.title}</span>
                  </a>
                  {featured.data.url && (
                    <a class="btn btn--secondary" href={featured.data.url} rel="noopener noreferrer" target="_blank">
                      {s.workLiveSite ?? 'Live site'}
                      <Icon name="external" size={18} />
                      <span class="visually-hidden"> for {featured.data.title} (opens in a new tab)</span>
                    </a>
                  )}
                </div>
              </div>
            </article>
          )}

          {projectCards.length > 0 && (
            <ul class="projects">
              {projectCards.map((p) => (
                <li class="card project">
                  <Image src={p.data.image} alt={p.data.imageAlt} widths={[400, 800]} sizes="(min-width: 56rem) 30vw, (min-width: 36rem) 50vw, 100vw" class="project__img" />
                  <h3>
                    <a href={`/case-studies/${p.id}/`}>{p.data.title}</a>
                  </h3>
                  {projectMeta(p) && <p class="project__meta">{projectMeta(p)}</p>}
                </li>
              ))}
            </ul>
          )}
        </div>
      </section>
    )
  }

  <!-- Paid search results -->
  {
    features.ads && ads.length > 0 && (
      <section class="section theme-cream" id="ads" aria-labelledby="ads-heading">
        <div class="container">
          <div class="section__head">
            <h2 id="ads-heading">{s.adsHeading ?? 'Paid search results'}</h2>
            {s.adsIntro && <p class="lead">{s.adsIntro}</p>}
          </div>
          {data.adsStats && data.adsStats.length > 0 && (
            <dl class="ad-stats">
              {data.adsStats.map((stat) => (
                <div>
                  <dt>{stat.label}</dt>
                  <dd>{stat.value}</dd>
                </div>
              ))}
            </dl>
          )}
          <ul class="ad-cards">
            {ads.map((a) => (
              <li class="card ad-card">
                <p class="ad-card__tag">{a.data.industry} &middot; {a.data.campaignTypes}</p>
                <h3>{a.data.client}</h3>
                <p class="ad-card__result">{a.data.result}</p>
                {a.data.resultDetail && <p class="ad-card__detail">{a.data.resultDetail}</p>}
                <span class="ad-card__spacer" aria-hidden="true" />
                <a class="btn btn--secondary" href={`/case-studies/ads/${a.id}/`}>
                  {s.adsCaseStudy ?? 'Case study'}<span class="visually-hidden">: {a.data.client}</span> <span aria-hidden="true">&rarr;</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <!-- About -->
  <section class="section theme-green" id="about" aria-labelledby="about-heading">
    <div class="container about" class:list={{ 'about--photo': data.image }}>
      <!-- Decorative maroon star stickers. Phones: a cluster above the heading (stars--top) and one below the text.
           Wider screens: the clusters sit in side margins beside the first and last lines (stars--side, stars--bottom). -->
      <div class="stars stars--top" aria-hidden="true"><svg class="star star--big" viewBox="0 0 100 100"><path d="M50 0C54 36 64 46 100 50C64 54 54 64 50 100C46 64 36 54 0 50C36 46 46 36 50 0Z" /></svg><svg class="star star--sm1" viewBox="0 0 100 100"><path d="M50 0C54 36 64 46 100 50C64 54 54 64 50 100C46 64 36 54 0 50C36 46 46 36 50 0Z" /></svg><svg class="star star--sm2" viewBox="0 0 100 100"><path d="M50 0C54 36 64 46 100 50C64 54 54 64 50 100C46 64 36 54 0 50C36 46 46 36 50 0Z" /></svg></div>
      <div class="about__text">
        <h2 id="about-heading">{s.aboutHeading}</h2>
        <div class="about__body">
          <div class="stars stars--side" aria-hidden="true"><svg class="star star--big" viewBox="0 0 100 100"><path d="M50 0C54 36 64 46 100 50C64 54 54 64 50 100C46 64 36 54 0 50C36 46 46 36 50 0Z" /></svg><svg class="star star--sm1" viewBox="0 0 100 100"><path d="M50 0C54 36 64 46 100 50C64 54 54 64 50 100C46 64 36 54 0 50C36 46 46 36 50 0Z" /></svg><svg class="star star--sm2" viewBox="0 0 100 100"><path d="M50 0C54 36 64 46 100 50C64 54 54 64 50 100C46 64 36 54 0 50C36 46 46 36 50 0Z" /></svg></div>
          <div class="prose"><AboutText /></div>
        </div>
      </div>
      <div class="stars stars--bottom" aria-hidden="true"><svg class="star star--big" viewBox="0 0 100 100"><path d="M50 0C54 36 64 46 100 50C64 54 54 64 50 100C46 64 36 54 0 50C36 46 46 36 50 0Z" /></svg><svg class="star star--sm1" viewBox="0 0 100 100"><path d="M50 0C54 36 64 46 100 50C64 54 54 64 50 100C46 64 36 54 0 50C36 46 46 36 50 0Z" /></svg><svg class="star star--sm2" viewBox="0 0 100 100"><path d="M50 0C54 36 64 46 100 50C64 54 54 64 50 100C46 64 36 54 0 50C36 46 46 36 50 0Z" /></svg></div>
      {
        data.image && (
          <Image src={data.image} alt={data.imageAlt ?? ''} widths={[480, 800]} sizes="(min-width: 56rem) 40vw, 100vw" class="about__img" />
        )
      }
    </div>
  </section>

  <!-- Join -->
  <section class="section join theme-cream" id="join" aria-labelledby="join-heading">
    <div class="container join__inner">
      <div class="join__form">
        <h2 id="join-heading">{s.joinHeading}</h2>
        {s.joinIntro && <p class="lead">{s.joinIntro}</p>}
        <JoinForm experience={data.joinExperience} buttonLabel={s.joinButton} />
      </div>

      <aside class="join__details theme-green" aria-label="Meeting details and other ways to connect">
        <h3>{s.meetingHeading}</h3>
        <address>
          {meeting.name}
          <br />
          {meeting.street}, {meeting.city}, {meeting.region} {meeting.postalCode}
        </address>
        {meeting.notes && <p>{meeting.notes}</p>}
        <p><a href={meeting.mapUrl} rel="noopener noreferrer" target="_blank">Open in maps<span class="visually-hidden"> (opens in a new tab)</span></a></p>

        <ul class="contact-list">
          <li><Icon name="mail" size={20} /><a href={`mailto:${site.email}`}>{site.email}</a></li>
          {site.phone && <li><Icon name="phone" size={20} /><a href={`tel:${site.phone.tel}`}>{site.phone.display}</a></li>}
        </ul>

        {
          site.joinLinks.length > 0 && (
            <>
              <h3>{s.otherWaysHeading}</h3>
              <ul class="plain">
                {site.joinLinks.map((l) => (
                  <li>
                    <a href={l.url} rel="noopener noreferrer" target="_blank">{l.label}<span class="visually-hidden"> (opens in a new tab)</span></a>
                  </li>
                ))}
              </ul>
            </>
          )
        }
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(3.5rem, 2rem + 8vw, 7rem);
    background: var(--sec-bg);
  }
  .hero :global(.hero__bg) {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Wash in the section color keeps text readable over the image. Strength comes from `heroOverlay` in home.md (--hero-wash, 0-1). */
  .hero--image::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: color-mix(in srgb, var(--sec-bg) calc(var(--hero-wash) * 100%), transparent);
  }
  @media (min-width: 56rem) {
    .hero--image::before {
      background: linear-gradient(
        90deg,
        color-mix(in srgb, var(--sec-bg) calc((var(--hero-wash) + 0.12) * 100%), transparent) 0%,
        color-mix(in srgb, var(--sec-bg) calc(var(--hero-wash) * 100%), transparent) 50%,
        color-mix(in srgb, var(--sec-bg) calc((var(--hero-wash) - 0.48) * 100%), transparent) 100%
      );
    }
  }
  .hero__inner { display: grid; gap: var(--space-12); align-items: center; }
  .hero__text { max-width: 44rem; }
  .hero__frame {
    width: min(100%, 26rem);
    padding: var(--space-3);
    border-radius: var(--radius);
    background: var(--color-highlight);
    box-shadow: var(--shadow);
  }
  .hero :global(.hero__photo) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius-sm);
  }
  /* Empty frame: a soft inner panel until a photo is added */
  .hero__photo--empty { border: 2px dashed color-mix(in srgb, var(--color-background) 55%, transparent); }
  @media (min-width: 56rem) {
    .hero__inner { grid-template-columns: 1fr minmax(16rem, 24rem); }
    .hero__frame { justify-self: end; }
  }
  .hero__sub { margin-bottom: var(--space-6); }
  .hero__area {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: var(--space-6) 0 0;
    color: var(--color-muted);
    font-weight: 600;
  }

  /* About */
  .about { display: grid; gap: var(--space-8); align-items: center; }
  /* Star stickers: decorative. Top cluster sits in the corner beside the heading;
     the bottom cluster is the same group turned 180 degrees, placed below the text. */
  .about { position: relative; --star-size: clamp(2.25rem, 1.25rem + 3vw, 4.25rem); }
  .stars {
    position: relative;
    width: calc(var(--star-size) * 1.9);
    height: calc(var(--star-size) * 1.45);
    pointer-events: none;
  }
  .stars--top { position: absolute; top: calc(-1 * var(--star-size) * 0.85); right: 0; }
  .about__body { position: relative; }
  .stars--side { display: none; }
  /* Pulled up against the last paragraph so it hugs the text's bottom-left corner */
  .stars--bottom { rotate: 180deg; margin-top: calc(-1 * var(--space-8) + var(--space-2)); }
  /* Wider screens: indent the text to make a left margin, and tuck the bottom cluster
     into that margin beside the last paragraph's bottom-left corner */
  @media (min-width: 56rem) {
    .about:not(.about--photo) .about__text { padding-inline: calc(var(--star-size) * 1.75); }
    /* Right margin cluster: the first line of the first paragraph sits between its two small stars */
    .about:not(.about--photo) .stars--top { display: none; }
    .about:not(.about--photo) .stars--side { display: block; position: absolute; right: calc(var(--star-size) * -1.75); top: calc(0.85rem - var(--star-size) * 0.7); }
    /* Lowered so the last line of text (it starts with "automatically" on a typical
       desktop width) sits in the gap between the two small stars */
    .about:not(.about--photo) .stars--bottom { position: absolute; left: 0; bottom: calc(var(--star-size) * -0.7 + 0.85rem); margin: 0; }
  }
  .star { position: absolute; height: auto; fill: var(--color-primary); }
  .star--big { width: var(--star-size); right: 0; top: calc(var(--star-size) * 0.3); rotate: 12deg; }
  .star--sm1 { width: calc(var(--star-size) * 0.45); right: calc(var(--star-size) * 1.1); top: 0; rotate: -10deg; }
  .star--sm2 { width: calc(var(--star-size) * 0.3); right: calc(var(--star-size) * 1); top: calc(var(--star-size) * 0.95); rotate: 15deg; }
  .about :global(.about__img) { width: 100%; border-radius: var(--radius); box-shadow: var(--shadow); }
  @media (min-width: 56rem) {
    .about--photo { grid-template-columns: 1.1fr 1fr; gap: var(--space-12); }
  }

  .cards { list-style: none; margin: 0; padding: 0; }

  /* Selected work */
  .project-featured {
    display: grid;
    gap: var(--space-6);
    align-items: center;
    margin-bottom: var(--space-6);
  }
  .project-featured h3 { font-size: var(--text-xl); margin-bottom: var(--space-2); }
  .project-featured__result { font-size: var(--text-lg); margin-bottom: var(--space-3); }
  .project-featured__actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-2); }
  .badge {
    display: inline-block;
    margin: 0 0 var(--space-3);
    padding: 0.2rem 0.75rem;
    border-radius: 999px;
    background: var(--color-highlight);
    color: var(--color-background);
    font-size: var(--text-sm);
    font-weight: 700;
  }
  .project__meta { color: var(--color-muted); font-size: var(--text-sm); font-weight: 600; }
  .projects {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-6);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
  }
  .project h3 { margin: var(--space-4) 0 var(--space-1); }
  /* The whole card is clickable through the heading link */
  .project { position: relative; }
  .project h3 a { text-decoration: none; }
  .project h3 a::after { content: ''; position: absolute; inset: 0; border-radius: var(--radius); }
  .project:hover h3 a { text-decoration: underline; }
  .project__meta:last-child { margin-bottom: 0; }
  :global(.project__img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 8 / 5;
    object-fit: cover;
    border-radius: var(--radius-sm);
  }
  @media (min-width: 56rem) {
    .project-featured { grid-template-columns: 1.4fr 1fr; gap: var(--space-8); }
  }

  /* Paid search results */
  .ad-stats {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 11rem), 1fr));
    margin: 0 0 var(--space-8);
  }
  /* Show the number above its label */
  .ad-stats div { display: flex; flex-direction: column-reverse; }
  .ad-stats dd { margin: 0; font-size: var(--text-2xl); font-weight: 800; line-height: 1.1; }
  .ad-stats dt { margin-top: var(--space-1); }
  .ad-cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-6);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
  }
  .ad-card { display: flex; flex-direction: column; align-items: flex-start; }
  .ad-card__tag { margin: 0 0 var(--space-1); color: var(--color-muted); font-size: var(--text-sm); font-weight: 600; }
  .ad-card h3 { margin-bottom: var(--space-4); }
  .ad-card__result { margin: 0; font-size: var(--text-2xl); font-weight: 800; line-height: 1.15; color: var(--color-primary); }
  .ad-card__detail { margin: var(--space-1) 0 0; }
  /* Push the button to the bottom so buttons line up across cards */
  .ad-card__spacer { flex: 1; min-height: var(--space-4); }

  /* Join */
  .join__inner { display: grid; gap: var(--space-12); }
  /* Green panel (theme-green): cream text, links and icons */
  .join__details {
    align-self: start;
    padding: var(--space-6);
    border-radius: var(--radius);
  }
  .join__details h3 { margin-top: var(--space-6); }
  .join__details h3:first-child { margin-top: 0; }
  .join__details address { font-style: normal; margin-bottom: var(--space-2); }
  .contact-list, .plain { list-style: none; margin: 0 0 var(--space-4); padding: 0; }
  .contact-list li { display: flex; gap: var(--space-3); align-items: center; margin-bottom: var(--space-2); }
  .contact-list :global(svg) { flex: none; color: var(--sec-accent); }
  .plain li { margin-bottom: var(--space-2); }
  .join__form .lead { margin-bottom: var(--space-6); }
  @media (min-width: 56rem) {
    .join__inner { grid-template-columns: 1.4fr 1fr; }
  }
</style>
