---
import { getCollection, getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';

const page = await getEntry('pages', 'case-studies');
if (!page) throw new Error('Missing content: src/content/pages/case-studies.md');
const { data } = page;
const s = data.sections ?? {};

const byOrder = <T extends { data: { order: number } }>(a: T, b: T) => a.data.order - b.data.order;
const projects = (await getCollection('projects')).sort(byOrder);
const ads = (await getCollection('ads')).sort(byOrder);
const meta = (p: (typeof projects)[number]) => [p.data.type, p.data.year, p.data.role].filter(Boolean).join(' · ');
---

<BaseLayout title={data.title} description={data.description}>
  <section class="section theme-cream intro">
    <div class="container">
      <div class="section__head">
        <h1>{data.heading}</h1>
        {data.intro && <p class="lead">{data.intro}</p>}
      </div>
    </div>
  </section>

  {
    projects.length > 0 && (
      <section class="section theme-maroon" aria-labelledby="web-heading">
        <div class="container">
          <h2 id="web-heading">{s.webHeading ?? 'Websites'}</h2>
          <ul class="studies">
            {projects.map((p) => (
              <li class="card study">
                <Image src={p.data.image} alt={p.data.imageAlt} widths={[400, 800]} sizes="(min-width: 56rem) 45vw, 100vw" class="study__img" />
                <h3>
                  <a href={`/case-studies/${p.id}/`}>{p.data.title}</a>
                </h3>
                {meta(p) && <p class="study__meta">{meta(p)}</p>}
                {p.data.result && <p>{p.data.result}</p>}
                <p class="study__more" aria-hidden="true">{s.readMore ?? 'Read the case study'} &rarr;</p>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  {
    ads.length > 0 && (
      <section class="section theme-cream" aria-labelledby="ads-heading">
        <div class="container">
          <h2 id="ads-heading">{s.adsHeading ?? 'Google Ads'}</h2>
          <ul class="studies">
            {ads.map((a) => (
              <li class="card study">
                <p class="study__meta">{a.data.industry} &middot; {a.data.campaignTypes}</p>
                <h3>
                  <a href={`/case-studies/ads/${a.id}/`}>{a.data.client}</a>
                </h3>
                <p class="study__result">{a.data.result}</p>
                {a.data.resultDetail && <p>{a.data.resultDetail}</p>}
                <p class="study__more" aria-hidden="true">{s.readMore ?? 'Read the case study'} &rarr;</p>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .intro { padding-bottom: 0; }
  .intro .section__head { margin-bottom: var(--space-12); }
  .studies {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-6);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
  }
  /* The whole card is clickable through the heading link */
  .study { position: relative; }
  .study h3 { font-size: var(--text-xl); margin: var(--space-4) 0 var(--space-1); }
  .study__meta + h3 { margin-top: 0; }
  .study h3 a { text-decoration: none; }
  .study h3 a::after { content: ''; position: absolute; inset: 0; border-radius: var(--radius); }
  .study:hover h3 a { text-decoration: underline; }
  .study__result { margin-bottom: var(--space-1); font-size: var(--text-xl); font-weight: 800; color: var(--color-primary); }
  .section h2 { margin-bottom: var(--space-6); }
  .study__meta { color: var(--color-muted); font-size: var(--text-sm); font-weight: 600; margin-bottom: var(--space-2); }
  .study__more { margin: 0; color: var(--color-primary); font-weight: 650; }
  .study :global(.study__img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 8 / 5;
    object-fit: cover;
    border-radius: var(--radius-sm);
  }
</style>
