---
import { site } from '../config/site';

interface Props {
  experience?: string[];
  buttonLabel?: string;
}

const { experience = [], buttonLabel = 'Send my details' } = Astro.props;
---

<form class="join-form" action={site.basinEndpoint} method="POST" accept-charset="UTF-8">
  <div class="field">
    <label for="jf-name">Name <span class="req">(required)</span></label>
    <input id="jf-name" name="name" type="text" autocomplete="name" required />
    <p class="field-error" aria-hidden="true">Please enter your name.</p>
  </div>

  <div class="field">
    <label for="jf-email">Email <span class="req">(required)</span></label>
    <input id="jf-email" name="email" type="email" autocomplete="email" required />
    <p class="field-error" aria-hidden="true">Please enter a valid email address.</p>
  </div>

  <div class="field">
    <label for="jf-phone">Phone <span class="opt">(optional)</span></label>
    <input id="jf-phone" name="phone" type="tel" autocomplete="tel" />
  </div>

  {
    experience.length > 0 && (
      <div class="field">
        <label for="jf-experience">Running experience <span class="opt">(optional)</span></label>
        <select id="jf-experience" name="experience" autocomplete="off">
          <option value="">Select one</option>
          {experience.map((option) => <option value={option}>{option}</option>)}
        </select>
      </div>
    )
  }

  <div class="field">
    <label for="jf-message">Anything we should know? <span class="opt">(optional)</span></label>
    <textarea id="jf-message" name="message" rows="4" autocomplete="off"></textarea>
  </div>

  <!-- Honeypot: hidden from people and assistive tech; bots fill it in. Basin flags submissions where it has a value. -->
  <div class="hp" aria-hidden="true">
    <label for="jf-gotcha">Leave this field empty</label>
    <input id="jf-gotcha" name="_gotcha" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <button class="btn btn--primary" type="submit">{buttonLabel}</button>
</form>

<style>
  .join-form { display: grid; gap: var(--space-4); }
  .field { display: grid; gap: var(--space-1); }
  label { font-weight: 650; }
  .req, .opt { font-weight: 400; font-size: var(--text-sm); }

  input,
  select,
  textarea {
    width: 100%;
    min-height: 2.75rem;
    padding: 0.6rem 0.75rem;
    border: 2px solid var(--color-primary);
    border-radius: var(--radius-sm);
    background: var(--color-background);
    color: var(--color-ink);
    font: inherit;
  }
  textarea { resize: vertical; min-height: 6.5rem; }
  input:focus-visible,
  select:focus-visible,
  textarea:focus-visible { outline: var(--focus); outline-offset: 2px; }

  /* Native validation, styled once the visitor has interacted with the field */
  input:user-invalid,
  textarea:user-invalid {
    border-color: #b42318;
    background: #fff5f4;
  }
  .field-error {
    display: none;
    margin: 0;
    color: var(--sec-text, #b42318);
    font-size: var(--text-sm);
    font-weight: 600;
  }
  .field:has(:user-invalid) .field-error { display: block; }

  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .btn { justify-self: start; }
</style>
